# TherapyVoid / Therapy Funnel — переменные окружения (пример, БЕЗ значений)
# Реальные значения — только в Render env vars и локальном .env.local (gitignored).
# Никогда не коммить настоящие значения.

NODE_ENV=production
PORT=10000

# JWT: сгенерировать `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-random-64-char-hex

# DeepSeek API (platform.deepseek.com)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Neon PostgreSQL (полная строка подключения)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Resend (resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=TherapyVoid <noreply@yourdomain.com>
